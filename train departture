class Solution {
  public:
    int minPlatform(vector<int>& arr, vector<int>& dep) {
        sort(arr.begin(), arr.end());
        sort(dep.begin(), dep.end());
         int i=0, j=0, platform=0, ans=0;
         while(i<arr.size() && j<dep.size())
         {
             if(arr[i]<=dep[j])
             {
                 platform++;
                 ans=max(ans,platform);
                 i++;
             }else
             {
                 platform--;
                 j++;
             }
         }
         return ans;
    }
};
