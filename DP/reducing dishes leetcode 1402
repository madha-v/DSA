class Solution {
    int dp[501][501];
    int solve(vector<int>& satisfaction , int i, int t)
    {
        if(i==satisfaction.size()){
            return 0;
        }
        if(dp[i][t]!=-1){
            return dp[i][t];
        }
        int take=satisfaction[i]*t+solve(satisfaction,i+1,t+1);
        int nottake=solve(satisfaction,i+1,t);

        return dp[i][t]= max(take , nottake);
        
    }
public:
    int maxSatisfaction(vector<int>& satisfaction) {
        sort(satisfaction.begin(), satisfaction.end());
        memset(dp,-1,sizeof(dp));
        return solve(satisfaction,0,1);
    }
};
