class Solution {
public:
    void mergeArrays(vector<int>& a, vector<int>& b) {

        int n = a.size();
        int m = b.size();

        vector<int> ans;

        for(int x : a)
            ans.push_back(x);

        for(int x : b)
            ans.push_back(x);

        sort(ans.begin(), ans.end());

      for(int i=0;i<n;i++)
      {
          a[i]=ans[i];
      }
      for(int i=0;i<m;i++)
      {
          b[i]=ans[n+i];
      }
    }
    
