class Solution {
    vector<int>solve(string s){
            int n=s.size();
          vector<int>res;
        for(int i=0;i<n;i++)
        {
            if(s[i]=='+' || s[i]=='-'|| s[i]=='*'){ // if foumd operator divide into two left and right substring
                vector<int> leftres= solve(s.substr(0,i)); // this is left one till ith index
               vector<int> rightres=solve(s.substr(i+1)); // right one from i+1 to n 

                for(int &x:leftres){ 
                    for(int &y:rightres){ // now checking left to right making all possible combination
                        if(s[i]=='+'){ // if + sign found then add 
                            res.push_back(x+y);
                        }
                        else if(s[i]=='-'){
                            res.push_back(x-y);
                        }
                        else{
                            res.push_back(x*y);
                        }
                    }
                }
            }
            
        }
         if(res.empty()){ // if only int value / single value is present like s=12 so return 12 in int fprmat 
                res.push_back(stoi(s));

            }
         return res;   
    }
public:
    vector<int> diffWaysToCompute(string s) {
    
         return solve(s);
    }
};
