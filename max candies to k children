class Solution {
    bool solve(vector<int>& candies, long long k , int mid)
    {
        int n=candies.size();
        int c=0;
        for(int i=0;i<n;i++)
        {
                c+=candies[i]/mid;

                if(c>=k)
                {
                    return true;
                }
        }
        return false;
    }
public:
    int maximumCandies(vector<int>& candies, long long k) {

        long long total = accumulate(candies.begin(), candies.end(), 0LL);

        if(total < k)
            return 0;
        int res=0;
        int l = 1;
        int r = *max_element(candies.begin(), candies.end());
        while(l<=r)
        {
            int mid=l+(r-l)/2;
            if(solve(candies, k, mid)){
                res=mid;
                l=mid+1;
            }
            else
            {
                r=mid-1;
            }
        }
       return res;
    }
};
