class Solution {
public:
    int minMaxDifference(int num) {
        string s1=to_string(num);
        string s2=s1;
        for(char ch:s1)
        {
            if(ch!='9')
            {
                replace(begin(s1),end(s1),ch,'9');
                break;
            }
        }
       for(int i=0;i<s2.size();i++)
        {
            char ch=s2[i];
            if(i==0)
            {
                if(ch!='0')
                {
                    replace(s2.begin(),s2.end(),ch,'0');
                    break;
                }
            }
           
        }
        return stoi(s1)-stoi(s2);
    }
};
